{
  "scenarios": [
    {
      "id": "text_delta_events",
      "ac": "ac22",
      "description": "串流產生 text_delta 事件",
      "input": "請介紹一下你自己",
      "expect": {
        "has_stream_events": ["text_delta"],
        "content_not_empty": true
      }
    },
    {
      "id": "stream_complete_event",
      "ac": "ac22",
      "description": "串流包含完成事件",
      "input": "你好",
      "expect": {
        "has_stream_events": ["text_delta"],
        "content_not_empty": true
      }
    },
    {
      "id": "stream_tool_call_events",
      "ac": "ac22",
      "description": "工具呼叫串流事件",
      "input": "請幫我計算寄到台北的運費，包裹重量 2 公斤",
      "use_all_tools": true,
      "expect": {
        "has_stream_events": ["text_delta"],
        "content_not_empty": true
      }
    }
  ]
}
